# Aleya backend environment configuration
# Copy this file to .env and adjust the values for your local setup.

# Server
PORT=5000

# Database
DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@localhost:5432/aleya
DATABASE_SSL=false

# Authentication & security
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
EMAIL_VERIFICATION_TTL_HOURS=48
EMAIL_VERIFICATION_URL=
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_FILE=logs/aleya.log
LOG_LEVEL=info
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# Email (required for outbound mail)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Aleya <noreply@aleya.local>"
SMTP_SECURE=false

# Seed admin bootstrap (optional)
SEED_ADMIN_EMAIL=admin@aleya.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD
SEED_ADMIN_NAME=Aleya Admin

# Background jobs
MENTOR_DIGEST_WINDOW_HOURS=24
